import argparse
import subprocess
import itertools
import logging
import re
from datetime import datetime

def setup_loggers():
    """Configure Simple and Full loggers."""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    
    # Full Logger (Everything)
    full_logger = logging.getLogger("FullLog")
    full_logger.setLevel(logging.DEBUG)
    full_handler = logging.FileHandler(f"output/bench_full_{timestamp}.log")
    full_handler.setFormatter(logging.Formatter('%(asctime)s - %(message)s'))
    full_logger.addHandler(full_handler)

    # Simple Logger (Summaries only)
    simple_logger = logging.getLogger("SimpleLog")
    simple_logger.setLevel(logging.INFO)
    simple_handler = logging.FileHandler(f"output/bench_simple_{timestamp}.log")
    simple_handler.setFormatter(logging.Formatter('%(message)s'))
    simple_logger.addHandler(simple_handler)

    # Console output for the terminal
    console = logging.StreamHandler()
    console.setLevel(logging.INFO)
    simple_logger.addHandler(console)

    return simple_logger, full_logger

def run_srun(command, simple_logger, full_logger, description):
    """Executes an srun command, logs full output, and returns stdout."""
    full_logger.debug(f"\n{'='*50}\n[START] {description}\nCMD: {' '.join(command)}")
    
    try:
        # Run the command and capture output
        result = subprocess.run(
            command, 
            stdout=subprocess.PIPE, 
            stderr=subprocess.STDOUT, 
            text=True,
            timeout=900 # 15 minute timeout safety net
        )
        
        full_logger.debug(result.stdout)
        full_logger.debug(f"[END] {description} - Exit Code: {result.returncode}\n{'='*50}")
        return result.stdout, result.returncode
        
    except subprocess.TimeoutExpired:
        full_logger.error(f"[TIMEOUT] {description} exceeded 15 minutes.")
        return None, -1
    except Exception as e:
        full_logger.error(f"[ERROR] {description} failed: {str(e)}")
        return None, -1

def main():
    parser = argparse.ArgumentParser(description="Master Benchmark Runner")
    parser.add_argument('--nodes', nargs='+', required=True, help="List of nodes to test (e.g., c18-17 c18-18 c21-01)")
    parser.add_argument('--reservation', type=str, default=None, help="Name of reservation. If omitted, runs in dry-run mode.")
    args = parser.parse_args()

    simple_logger, full_logger = setup_loggers()
    
    mode = f"RESERVATION: {args.reservation}" if args.reservation else "DRY RUN (No Reservation)"
    simple_logger.info(f"--- Starting Benchmark Suite | Mode: {mode} ---")
    simple_logger.info(f"Target Nodes: {', '.join(args.nodes)}\n")

    # Base Slurm flags using our admin shortcut
    base_slurm = ["srun", "--cluster=chip-cpu", "--partition=support", "--qos=support", "--account=pi_doit", "--mem=16G"]
    if args.reservation:
        base_slurm.append(f"--reservation={args.reservation}")

    # ==========================================
    # Phase 1: Individual Node Benchmarks
    # ==========================================
    simple_logger.info("=== PHASE 1: Single Node Benchmarks ===")
    for node in args.nodes:
        cmd = base_slurm + [f"--nodelist={node}", "--nodes=1", "python", "cpu_bench.py"]
        
        stdout, code = run_srun(cmd, simple_logger, full_logger, f"CPU Bench on {node}")
        
        if code == 0:
            # TODO: Add specific regex here to parse the exact result metric from cpu_bench.py's stdout
            simple_logger.info(f"[SUCCESS] {node}: CPU Benchmark completed successfully.")
        else:
            simple_logger.info(f"[FAILED]  {node}: CPU Benchmark encountered an error.")

    # ==========================================
    # Phase 2: N x N Bandwidth Matrix
    # ==========================================
    simple_logger.info("\n=== PHASE 2: Cross-Node Bandwidth Matrix ===")
    
    if len(args.nodes) < 2:
        simple_logger.info("Skipping Phase 2: Need at least 2 nodes for network tests.")
        return

    # Generate all unique pairs (e.g., A->B, A->C, B->C)
    node_pairs = list(itertools.combinations(args.nodes, 2))
    
    for src, dest in node_pairs:
        # Example using a standard MPI/network benchmark approach spanning 2 nodes
        # You will replace 'my_network_bench.sh' with your actual bandwidth script
        cmd = base_slurm + [f"--nodelist={src},{dest}", "--nodes=2", "bash", "my_network_bench.sh"]
        
        stdout, code = run_srun(cmd, simple_logger, full_logger, f"Bandwidth {src} <-> {dest}")
        
        if code == 0 and stdout:
            # Placeholder: Parse the average bandwidth from stdout
            # match = re.search(r'Average Bandwidth: ([\d\.]+) Gbps', stdout)
            # avg_bw = match.group(1) if match else "Unknown"
            
            simple_logger.info(f"[SUCCESS] {src} <-> {dest} : Avg Bandwidth: [Placeholder] Gbps")
        else:
            simple_logger.info(f"[FAILED]  {src} <-> {dest} : Bandwidth test failed.")

if __name__ == "__main__":
    main()
